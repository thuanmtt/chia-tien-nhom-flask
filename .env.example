# Mẫu biến môi trường — copy thành .env rồi điền giá trị thật:
#   cp .env.example .env
# .env nằm trong .gitignore, không bao giờ commit.

# Postgres Supabase — bắt buộc dùng connection string POOLER
# (Dashboard → Connect → Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth (Dashboard → Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# CHỈ dùng chạy test_api.py local — không deploy lên Vercel
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Chỉ cần khi migrate dữ liệu từ DB cũ
# OLD_DATABASE_URL=postgresql://...

# Tùy chọn: Redis cho rate limiting production (mặc định memory://)
# RATELIMIT_STORAGE_URI=redis://...
